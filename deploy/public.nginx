# Review before activation. This file is not applied by the preparation scripts.
server {
    listen 443 ssl;
    server_name sllm.kyurururn.net;
    ssl_certificate /etc/letsencrypt/live/sllm.kyurururn.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sllm.kyurururn.net/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    root /var/www/sllm/current/packages/scratch-gui/build;
    index index.html;
    access_log off;
    error_log /var/log/nginx/sllm-error.log warn;
    location / { try_files $uri $uri/ =404; }
    location = /admin { return 404; }
    location ^~ /api/admin/ { return 404; }
    location ^~ /api/events/ { return 404; }
    location /api/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 180s;
        client_max_body_size 2m;
    }
}
server {
    listen 80;
    server_name sllm.kyurururn.net;
    location /.well-known/acme-challenge/ { root /var/www/sllm/acme; }
    location / { return 301 https://sllm.kyurururn.net$request_uri; }
}
